@startuml IA2_DisasterRelief
allowmixing
left to right direction

skinparam classAttributeIconSize 0
skinparam classFontSize 11
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam classBorderThickness 1
skinparam ArrowColor #555555
skinparam ArrowThickness 1
skinparam NoteBackgroundColor #FFFFCC
skinparam NoteBorderColor #AAAAAA
skinparam groupInheritance 2
skinparam linetype ortho

together {
    class Person {
        - id : int
        - firstName : String
        - lastName : String
        - comments : String
        --
        + Person(firstName : String, lastName : String) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getFirstName() : String
        + setFirstName(firstName : String) : void throws IllegalArgumentException
        + getLastName() : String
        + setLastName(lastName : String) : void
        + getComments() : String
        + setComments(comments : String) : void
    }

    class DisasterVictim {
        - id : int
        - approximateAge : Integer
        - dateOfBirth : LocalDate
        - gender : String
        - {final} ENTRY_DATE : LocalDate
        - isSoftDeleted : boolean = false
        - location : Location
        - medicalRecords : ArrayList<MedicalRecord>
        - personalBelongings : ArrayList<Supply>
        - familyConnections : ArrayList<FamilyRelation>
        - culturalRequirements : ArrayList<CulturalRequirement>
        - victimSkills : ArrayList<VictimSkill>
        --
        + DisasterVictim(firstName : String, entryDate : LocalDate) throws IllegalArgumentException
        + setDateOfBirth(dateOfBirth : LocalDate) : void throws InvalidAgeException
        + getDateOfBirth() : LocalDate
        + setApproximateAge(age : int) : void throws InvalidAgeException
        + getApproximateAge() : Integer
        + getEntryDate() : LocalDate
        + getGender() : String
        + setGender(gender : String) : void throws IllegalArgumentException
        + getLocation() : Location
        + setLocation(location : Location) : void
        + getIsSoftDeleted() : boolean
        + softDelete() : void
        + getMedicalRecords() : ArrayList<MedicalRecord>
        + addMedicalRecord(record : MedicalRecord) : void throws IllegalArgumentException
        + getPersonalBelongings() : ArrayList<Supply>
        + addPersonalBelonging(supply : Supply) : void throws IllegalArgumentException
        + removePersonalBelonging(supply : Supply) : void throws IllegalArgumentException
        + getFamilyConnections() : ArrayList<FamilyRelation>
        + addFamilyConnection(relation : FamilyRelation) : void throws IllegalArgumentException
        + removeFamilyConnection(relation : FamilyRelation) : void throws IllegalArgumentException
        + getCulturalRequirements() : ArrayList<CulturalRequirement>
        + addCulturalRequirement(req : CulturalRequirement) : void throws IllegalArgumentException
        + removeCulturalRequirement(category : String) : void throws IllegalArgumentException
        + getVictimSkills() : ArrayList<VictimSkill>
        + addVictimSkill(skill : VictimSkill) : void throws IllegalArgumentException
        + removeVictimSkill(id : int) : void throws IllegalArgumentException
    }

    class Inquirer {
        - {final} INFO : String
        - {final} SERVICES_PHONE : String
        --
        + Inquirer(firstName : String, lastName : String, phone : String, info : String)
        + getServicesPhoneNum() : String
        + getInfo() : String
    }
}

note bottom of DisasterVictim
    setDateOfBirth() throws InvalidAgeException if approximateAge is already set.
    setApproximateAge() throws InvalidAgeException if dateOfBirth is already set.
    addCulturalRequirement() throws IllegalArgumentException if category already exists.
end note

together {
    class Location {
        - id : int
        - name : String
        - address : String
        - occupants : ArrayList<DisasterVictim>
        - supplies : ArrayList<Supply>
        --
        + Location(name : String, address : String) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getName() : String
        + setName(name : String) : void throws IllegalArgumentException
        + getAddress() : String
        + setAddress(address : String) : void throws IllegalArgumentException
        + getOccupants() : ArrayList<DisasterVictim>
        + addOccupant(victim : DisasterVictim) : void throws IllegalArgumentException
        + removeOccupant(victim : DisasterVictim) : void throws IllegalArgumentException
        + getSupplies() : ArrayList<Supply>
        + addSupply(supply : Supply) : void throws IllegalArgumentException
        + removeSupply(supply : Supply) : void throws IllegalArgumentException
    }

    class MedicalRecord {
        - id : int
        - victim : DisasterVictim
        - location : Location
        - treatmentDetails : String
        - treatmentDate : LocalDate
        --
        + MedicalRecord(location : Location, treatmentDetails : String, treatmentDate : LocalDate) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getVictim() : DisasterVictim
        + setVictim(victim : DisasterVictim) : void
        + getLocation() : Location
        + setLocation(location : Location) : void throws IllegalArgumentException
        + getTreatmentDetails() : String
        + setTreatmentDetails(details : String) : void throws IllegalArgumentException
        + getTreatmentDate() : LocalDate
        + setTreatmentDate(date : LocalDate) : void throws IllegalArgumentException
    }

    class FamilyRelation {
        - id : int
        - personOne : Person
        - relationshipTo : String
        - personTwo : Person
        --
        + FamilyRelation(personOne : Person, relationshipTo : String, personTwo : Person) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getPersonOne() : Person
        + setPersonOne(person : Person) : void throws IllegalArgumentException
        + getRelationshipTo() : String
        + setRelationshipTo(relationship : String) : void
        + getPersonTwo() : Person
        + setPersonTwo(person : Person) : void throws IllegalArgumentException
    }

    class Inquiry {
        - id : int
        - inquirer : Person
        - subjectPerson : Person
        - inquiryDate : LocalDateTime
        - details : String
        --
        + Inquiry(inquirer : Person, subjectPerson : Person, details : String) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getInquirer() : Person
        + getSubjectPerson() : Person
        + getInquiryDate() : LocalDateTime
        + getDetails() : String
        + setDetails(details : String) : void throws IllegalArgumentException
    }

    class CulturalRequirement {
        - id : int
        - requirementCategory : String
        - requirementOption : String
        --
        + CulturalRequirement(category : String, option : String) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getRequirementCategory() : String
        + getRequirementOption() : String
        + setRequirementOption(option : String) : void throws IllegalArgumentException
    }
}

together {
    class Supply {
        - id : int
        - type : String
        - location : Location
        - victim : DisasterVictim
        - allocationDate : LocalDate
        - description : String
        --
        + Supply(type : String) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getType() : String
        + setType(type : String) : void throws IllegalArgumentException
        + getLocation() : Location
        + setLocation(location : Location) : void
        + getVictim() : DisasterVictim
        + setVictim(victim : DisasterVictim) : void
        + getAllocationDate() : LocalDate
        + setAllocationDate(date : LocalDate) : void
        + getDescription() : String
        + setDescription(description : String) : void
        + allocateTo(victim : DisasterVictim, date : LocalDate) : void
        + isAllocated() : boolean
    }

    class PerishableSupply {
        - expiryDate : LocalDate
        --
        + PerishableSupply(type : String, expiryDate : LocalDate) throws IllegalArgumentException
        + getExpiryDate() : LocalDate
        + setExpiryDate(date : LocalDate) : void throws IllegalArgumentException
        + isExpired() : boolean
    }
}

together {
    class Skill {
        - id : int
        - skillName : String
        - category : String
        --
        + Skill(skillName : String, category : String) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getSkillName() : String
        + setSkillName(name : String) : void throws IllegalArgumentException
        + getCategory() : String
        + setCategory(category : String) : void throws IllegalArgumentException
    }

    class VictimSkill {
        - id : int
        - skill : Skill
        - proficiencyLevel : String
        --
        + VictimSkill(skill : Skill, proficiencyLevel : String) throws IllegalArgumentException
        + getId() : int
        + setId(id : int) : void
        + getSkill() : Skill
        + getProficiencyLevel() : String
        + setProficiencyLevel(level : String) : void throws IllegalArgumentException
    }

    class MedicalSkill {
        + {static} {final} VALID_CERTIFICATION_TYPES : String[] = {"first-aid","counseling","nursing","doctor"}
        - certificationType : String
        - certificationExpiry : LocalDate
        --
        + MedicalSkill(skill : Skill, proficiencyLevel : String, certificationType : String, certificationExpiry : LocalDate) throws IllegalArgumentException
        + getCertificationType() : String
        + setCertificationType(type : String) : void throws IllegalArgumentException
        + getCertificationExpiry() : LocalDate
        + setCertificationExpiry(date : LocalDate) : void
    }

    class LanguageSkill {
        - languageName : String
        - readWrite : boolean
        - speakListen : boolean
        --
        + LanguageSkill(skill : Skill, proficiencyLevel : String, languageName : String, readWrite : boolean, speakListen : boolean) throws IllegalArgumentException
        + getLanguageName() : String
        + setLanguageName(name : String) : void throws IllegalArgumentException
        + hasReadWrite() : boolean
        + setReadWrite(readWrite : boolean) : void
        + hasSpeakListen() : boolean
        + setSpeakListen(speakListen : boolean) : void
    }

    class TradeSkill {
        + {static} {final} VALID_TRADE_TYPES : String[] = {"carpentry","plumbing","electricity"}
        - tradeType : String
        --
        + TradeSkill(skill : Skill, proficiencyLevel : String, tradeType : String) throws IllegalArgumentException
        + getTradeType() : String
        + setTradeType(type : String) : void throws IllegalArgumentException
    }
}

together {
    interface DatabaseInterface {
        + loadAllVictims() : ArrayList<DisasterVictim>
        + loadAllLocations() : ArrayList<Location>
        + saveVictim(victim : DisasterVictim) : void
        + updateVictim(victim : DisasterVictim) : void
        + softDeleteVictim(id : int) : void
        + hardDeleteVictim(id : int) : void
        + saveSupply(supply : Supply) : void
        + updateSupply(supply : Supply) : void
        + saveMedicalRecord(record : MedicalRecord) : void
        + saveInquiry(inquiry : Inquiry) : void
        + saveFamilyRelation(relation : FamilyRelation) : void
        + saveCulturalRequirement(victimId : int, req : CulturalRequirement) : void
        + deleteCulturalRequirement(victimId : int, category : String) : void
        + saveVictimSkill(victimId : int, skill : VictimSkill) : void
        + deleteVictimSkill(skillId : int) : void
    }

    class DatabaseQueryHandler {
        - connection : Connection
        --
        + DatabaseQueryHandler(connection : Connection)
        + loadAllVictims() : ArrayList<DisasterVictim>
        + loadAllLocations() : ArrayList<Location>
        + saveVictim(victim : DisasterVictim) : void
        + updateVictim(victim : DisasterVictim) : void
        + softDeleteVictim(id : int) : void
        + hardDeleteVictim(id : int) : void
        + saveSupply(supply : Supply) : void
        + updateSupply(supply : Supply) : void
        + saveMedicalRecord(record : MedicalRecord) : void
        + saveInquiry(inquiry : Inquiry) : void
        + saveFamilyRelation(relation : FamilyRelation) : void
        + saveCulturalRequirement(victimId : int, req : CulturalRequirement) : void
        + deleteCulturalRequirement(victimId : int, category : String) : void
        + saveVictimSkill(victimId : int, skill : VictimSkill) : void
        + deleteVictimSkill(skillId : int) : void
    }

    class MockDatabaseQueryHandler {
        - victims : ArrayList<DisasterVictim>
        - locations : ArrayList<Location>
        --
        + MockDatabaseQueryHandler()
        + loadAllVictims() : ArrayList<DisasterVictim>
        + loadAllLocations() : ArrayList<Location>
        + saveVictim(victim : DisasterVictim) : void
        + updateVictim(victim : DisasterVictim) : void
        + softDeleteVictim(id : int) : void
        + hardDeleteVictim(id : int) : void
        + saveSupply(supply : Supply) : void
        + updateSupply(supply : Supply) : void
        + saveMedicalRecord(record : MedicalRecord) : void
        + saveInquiry(inquiry : Inquiry) : void
        + saveFamilyRelation(relation : FamilyRelation) : void
        + saveCulturalRequirement(victimId : int, req : CulturalRequirement) : void
        + deleteCulturalRequirement(victimId : int, category : String) : void
        + saveVictimSkill(victimId : int, skill : VictimSkill) : void
        + deleteVictimSkill(skillId : int) : void
    }
}

together {
    class DatabaseConnectionManager {
        - {static} instance : DatabaseConnectionManager = null
        - connection : Connection
        - {final} CONFIG_FILE : String = "src/main/resources/config.txt"
        --
        - DatabaseConnectionManager()
        + {static} getInstance() : DatabaseConnectionManager throws DatabaseConnectionException
        + getConnection() : Connection
        + close() : void throws DatabaseConnectionException
    }

    class ActionLogger {
        - {static} instance : ActionLogger = null
        - {final} LOG_FILE : String = "data/action_log.txt"
        --
        - ActionLogger()
        + {static} getInstance() : ActionLogger
        + logAdd(entityType : String, id : int, description : String) : void
        + logUpdate(entityType : String, id : int, oldValue : String, newValue : String) : void
        + logDelete(entityType : String, id : int, description : String) : void
        + logSoftDelete(entityType : String, id : int, description : String) : void
    }

    class ErrorLogger {
        - {static} instance : ErrorLogger = null
        - {final} LOG_FILE : String = "data/errorlog.txt"
        --
        - ErrorLogger()
        + {static} getInstance() : ErrorLogger
        + logError(message : String, e : Exception) : void
    }
}

together {
    class Main {
        + {static} main(args : String[]) : void throws DatabaseConnectionException
    }

    class ApplicationController {
        - db : DatabaseInterface
        - victims : ArrayList<DisasterVictim>
        - locations : ArrayList<Location>
        - availableRequirements : HashMap<String, ArrayList<String>>
        - view : ConsoleView
        --
        + ApplicationController(db : DatabaseInterface, view : ConsoleView)
        + run() : void
        + loadAvailableRequirements() : void
        + manageVictims() : void
        + addVictim() : void
        + updateVictim() : void
        + deleteVictim() : void
        + manageSupplies() : void
        + manageInquiries() : void
        + manageMedicalRecords() : void
        + manageFamilyRelations() : void
        + manageCulturalRequirements() : void
        + manageSkills() : void
    }

    class ConsoleView {
        - scanner : Scanner
        --
        + ConsoleView()
        + displayMainMenu() : int
        + displayVictims(victims : ArrayList<DisasterVictim>) : void
        + promptConfirmation(message : String) : boolean
        + promptDeletionMode() : String
        + displayExpiredSupplies(supplies : ArrayList<Supply>) : void
        + displayError(message : String) : void
        + displaySuccess(message : String) : void
        + promptInt(prompt : String, min : int, max : int) : int
        + promptString(prompt : String) : String
    }
}

together {
    class InvalidAgeException {
        + InvalidAgeException(message : String)
    }

    class DatabaseConnectionException {
        + DatabaseConnectionException(message : String)
    }
}

' Inheritance
Person <|-- DisasterVictim
Person <|-- Inquirer
Supply <|-- PerishableSupply
VictimSkill <|-- MedicalSkill
VictimSkill <|-- LanguageSkill
VictimSkill <|-- TradeSkill
Exception <|-- InvalidAgeException
Exception <|-- DatabaseConnectionException

' Interface implementation
DatabaseInterface <|.. DatabaseQueryHandler
DatabaseInterface <|.. MockDatabaseQueryHandler

' DB layer
DatabaseQueryHandler --> DatabaseConnectionManager : uses >

' Composition
DisasterVictim "1" *-- "0..*" MedicalRecord : contains >
DisasterVictim "1" *-- "0..*" CulturalRequirement : contains >
DisasterVictim "1" *-- "0..*" VictimSkill : contains >

' Aggregation
Location "1" o-- "0..*" DisasterVictim : houses >
Location "1" o-- "0..*" Supply : stores >
DisasterVictim "1" o-- "0..*" Supply : allocated to >

' Association
FamilyRelation "0..*" -- "2" Person : connects
Inquiry "0..*" --> "1" Person : inquirer >
Inquiry "0..*" --> "1" Person : subject >
VictimSkill "0..*" --> "1" Skill : references >
MedicalRecord --> Location : at >
MedicalRecord --> DisasterVictim : for >

' MVC
Main --> ApplicationController : creates >
Main --> DatabaseConnectionManager : uses >
ApplicationController --> DatabaseInterface : uses >
ApplicationController --> ConsoleView : uses >
ApplicationController --> ActionLogger : uses >
ApplicationController --> ErrorLogger : uses >

' Throws
DisasterVictim ..> InvalidAgeException : <<throws>>
DatabaseConnectionManager ..> DatabaseConnectionException : <<throws>>

' Database
rectangle "PostgreSQL\nDatabase" as DB
DatabaseQueryHandler ..> DB : <<use>>

@enduml